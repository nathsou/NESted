//! The standard frame runtime: boots the console, then calls `main::init`
//! once and `main::update` once per frame. Linked automatically unless the
//! program defines its own `@reset` handler.

/// Frames completed since power-on; incremented by the NMI handler.
@shared pub var frames: u8 = 0;

@reset fn reset() {
    // The PPU needs two vertical blanks before it accepts writes.
    asm {
    wait1:
        bit $2002
        bpl wait1
    wait2:
        bit $2002
        bpl wait2
    }
    if defined(main::init) {
        main::init();
    }
    poke(0x2000, 0x80);
    loop {
        let seen = frames;
        while frames == seen {}
        if defined(main::update) {
            main::update();
        }
    }
}

@nmi fn nmi() {
    frames += 1;
    if defined(main::vblank) {
        main::vblank();
    }
}
