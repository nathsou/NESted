//! The standard frame runtime. It boots the console, calls `main::init`
//! once with rendering off, turns rendering on, then each frame reads the
//! controllers, calls `main::update` and publishes the frame in the next
//! vertical blank. Optional hooks: `main::vblank()` runs in every NMI (even
//! during lag frames), `main::scanline()` handles the MMC3 IRQ.
//!
//! Linked automatically unless the program defines its own `@reset`.
use std::nes;
use std::video;
use std::input;

/// Frames since power-on (wraps), counted in the NMI handler.
@shared pub var frames: u8 = 0;

@reset fn reset() {
    // The PPU accepts writes after two vertical blanks.
    asm {
    wait1:
        bit $2002
        bpl wait1
    wait2:
        bit $2002
        bpl wait2
    }
    video::reset();
    if defined(std::audio::reset) {
        std::audio::reset();
    }
    nes::PPUCTRL = video::ctrl;
    if defined(main::init) {
        main::init();
    }
    video::on();
    loop {
        input::poll();
        if defined(main::update) {
            main::update();
        }
        video::end_frame();
        video::wait();
    }
}

@nmi fn nmi() {
    video::publish();
    frames += 1;
    if defined(main::vblank) {
        main::vblank();
    }
    if defined(std::audio::tick) {
        std::audio::tick();
    }
}

@irq fn irq() {
    if defined(main::scanline) {
        main::scanline();
    }
}
