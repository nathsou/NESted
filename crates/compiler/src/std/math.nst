//! Integer helpers, random numbers and tables built at compile time.

@zp var seed: u16 = 0xace1;

/// A pseudo-random byte (16-bit xorshift; deterministic from power-on).
pub fn rand() -> u8 {
    var s = seed;
    s ^= s << 7;
    s ^= s >> 9;
    s ^= s << 8;
    seed = s;
    return lo(s) ^ hi(s);
}

/// A pseudo-random number in 0..n (n > 0).
pub fn below(n: u8) -> u8 {
    if n == 0 {
        return 0;
    }
    return u8((u16(rand()) * u16(n)) >> 8);
}

/// Mix entropy (a frame count, input timing) into the generator.
pub fn stir(value: u8) {
    seed ^= u16(value) | (u16(value) << 8);
    if seed == 0 {
        seed = 1;
    }
}

pub fn min(a: u8, b: u8) -> u8 {
    if a < b {
        return a;
    }
    return b;
}

pub fn max(a: u8, b: u8) -> u8 {
    if a > b {
        return a;
    }
    return b;
}

pub fn abs(v: i8) -> u8 {
    if v < 0 {
        return u8(-v);
    }
    return u8(v);
}

/// Distance between two bytes.
pub fn diff(a: u8, b: u8) -> u8 {
    if a > b {
        return a - b;
    }
    return b - a;
}

/// Sine of an angle in 1/256 turns, scaled to -127..127, computed at
/// compile time with Bhaskara's approximation.
fn sine(angle: u8) -> i8 {
    // x in 0..128 maps to 0..π: sin ≈ 4p / (20480 − p) with p = x(128 − x),
    // evaluated with q = p / 32 to stay within 16 bits.
    let x = u16(angle & 127);
    let q = (x * (128 - x)) >> 5;
    let v = (508 * q) / (640 - q);
    if angle >= 128 {
        return -i8(v);
    }
    return i8(v);
}

fn sine_table() -> [i8; 256] {
    var t: [i8; 256] = [0; 256];
    for i in 0..256 {
        t[i] = sine(u8(i));
    }
    return t;
}

/// `SIN[a]` = 127·sin(2πa/256).
pub const SIN: [i8; 256] = sine_table();

/// Cosine from the same table.
pub fn cos(angle: u8) -> i8 {
    return SIN[angle + 64];
}

pub fn sin(angle: u8) -> i8 {
    return SIN[angle];
}
