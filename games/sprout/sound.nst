//! Sprout's music and sound effects.
use std::audio::*;

const Q: u8 = 16;
const E: u8 = 8;

/// A bouncy loop in C major.
pub const MELODY: [u8; _] = [
    INSTRUMENT, 0,
    C5, E, E5, E, G5, Q, E5, E, G5, E, A5, Q,
    G5, E, E5, E, C5, Q, D5, E, E5, E, D5, Q,
    C5, E, E5, E, G5, Q, A5, E, G5, E, C6, Q,
    B5, E, G5, E, A5, E, B5, E, C6, Q * 2,
    A5, E, C6, E, A5, Q, G5, E, E5, E, G5, Q,
    F5, E, A5, E, F5, Q, E5, E, C5, E, E5, Q,
    D5, E, F5, E, A5, Q, G5, E, F5, E, E5, Q,
    D5, Q, G4, Q, C5, Q * 2,
    LOOP,
];

pub const HARMONY: [u8; _] = [
