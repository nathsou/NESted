pub const DRUMS: [u8; _] = [
    INSTRUMENT, 4, 12, E, INSTRUMENT, 5, 1, E, INSTRUMENT, 4, 6, E, INSTRUMENT, 5, 1, E,
    LOOP,
];

/// Quieter cave music: the bass alone with sparse drums.
pub const CAVE_DRUMS: [u8; _] = [INSTRUMENT, 5, 2, Q, 2, Q, INSTRUMENT, 4, 13, Q, INSTRUMENT, 5, 2, Q, LOOP];

