const STAR_ART: [u8; _] = "
................
................
............b...
...a.......bcb..
............b...
................
................
................
................
....c......b....
....c......b....
..ccccc.bbbcbbb.
....c......b....
....c......b....
................
................

cccccccca.a.a.a.
cbbbbbba.a.a.a.a
cbbbbbbaa.a.a.a.
cbbbbbba.a.a.a.a
cbbbbbbaa.a.a.a.
cbbbbbba.a.a.a.a
cbbbbbbaa.a.a.a.
caaaaaaa.a.a.a.a
................
................
................
................
................
................
................
................
";

/// Turn 16x16 text cells into 2-bit-per-pixel tiles.
fn encode(art: &[u8]) -> [u8; 2048] {
    var out: [u8; 2048] = [0; 2048];
    var pixel: u16 = 0;
    for i in 0..len(art) {
        let c = art[i];
        var value: u8 = 0;
        if c == 'a' {
            value = 1;
        } else if c == 'b' {
            value = 2;
        } else if c == 'c' {
            value = 3;
        } else if c != '.' {
            continue;
        }
        let cell = pixel >> 8;
        let row = u8(pixel >> 4) & 15;
        let col = u8(pixel) & 15;
        let tile = cell * 4 + u16((row >> 3) * 2 + (col >> 3));
        let at = tile * 16 + u16(row & 7);
        let bit: u8 = 0x80 >> (col & 7);
        if (value & 1) != 0 {
            out[raw at] |= bit;
        }
        if (value & 2) != 0 {
            out[raw at + 8] |= bit;
        }
        pixel += 1;
    }
    return out;
}

fn encode_stars() -> [u8; 128] {
    let all = encode(STAR_ART);
    var out: [u8; 128] = [0; 128];
    for i in 0..128 {
        out[i] = all[i];
    }
    return out;
}

/// Sprite tiles for CHR address $0800 (tile 0x80).
@bank(0) pub const SPRITE_TILES: [u8; 2048] = encode(SPRITE_ART);
/// Background tiles for CHR address $0010 (tile 1).
@bank(0) pub const STAR_TILES: [u8; 128] = encode_stars();
/// The font: printable ASCII from tile 0x20.
@bank(0) pub const FONT: [u8; _] = asset("assets/font.chr", 512..1536);

/// The logo, one tile per '#'.
pub const LOGO: [u8; _] = "
#...#..###..#...#..###.
##..#.#...#.#...#.#...#
#.#.#.#...#.#...#.#####
#..##.#...#..#.#..#...#
#...#..###....#...#...#
";
pub const LOGO_WIDTH: u8 = 23;
