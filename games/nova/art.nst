//! Nova's graphics, drawn as text and turned into NES tiles by the compiler.
//!
//! Each picture is a 16x16 cell: '.' is transparent, 'a', 'b' and 'c' are
//! colors 1-3 of the sprite's palette. A cell becomes four tiles (top-left,
//! top-right, bottom-left, bottom-right); small 8x8 pictures share a cell.
//! The tiles are built by `encode` at compile time, placed in a switchable
//! bank, and copied to the cartridge's CHR RAM at power-on.

/// First tile of the sprite cells.
pub const SPRITES: u8 = 0x80;
/// Sprite tiles: cell n starts at SPRITES + 4n.
pub const PLAYER: u8 = 0x80;
pub const FLAME: u8 = 0x84;
pub const FLAME2: u8 = 0x85;
pub const SHOT: u8 = 0x86;
pub const ORB: u8 = 0x87;
pub const BULLET: u8 = 0x88;
pub const BULLET2: u8 = 0x89;
pub const CAPSULE: u8 = 0x8a;
pub const BOMB: u8 = 0x8b;
pub const DRONE: u8 = 0x8c;
pub const DRONE2: u8 = 0x90;
pub const DART: u8 = 0x94;
pub const SAUCER: u8 = 0x98;
pub const ROCK: u8 = 0x9c;
pub const BOOM: u8 = 0xa0;
pub const BOSS_TOP: u8 = 0xa4;
pub const BOSS_BOTTOM: u8 = 0xa8;
pub const LIFE: u8 = 0xac;
pub const BAR_FULL: u8 = 0xad;
pub const BAR_HALF: u8 = 0xae;
pub const BAR_EMPTY: u8 = 0xaf;

/// Background tiles, from tile 1.
pub const DIM: u8 = 1;
pub const SMALL: u8 = 2;
pub const BRIGHT: u8 = 3;
pub const TWINKLE: u8 = 4;
pub const BLOCK: u8 = 5;
pub const SHADE: u8 = 6;

