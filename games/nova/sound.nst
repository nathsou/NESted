// -------------------------------------------------------------- effects

/// Channel 1: the player's shot.
pub const SHOT: [u8; _] = [INSTRUMENT, 5, C7, 2, G6, 2, END];
/// Channel 3 (noise): an enemy destroyed.
pub const BLAST: [u8; _] = [INSTRUMENT, 4, 9, 4, 11, 6, 13, 8, END];
/// Channel 3: a big explosion.
pub const BIG_BLAST: [u8; _] = [INSTRUMENT, 4, 6, 6, 8, 8, 10, 10, 12, 12, 14, 16, END];
/// Channel 1: a hit that didn't destroy.
pub const TINK: [u8; _] = [INSTRUMENT, 5, E7, 2, END];
/// Channel 0: a power-up collected.
pub const POWER: [u8; _] = [INSTRUMENT, 1, C5, 3, E5, 3, G5, 3, C6, 3, E6, 3, G6, 3, C7, 8, END];
/// Channel 0: an extra ship.
pub const ONE_UP: [u8; _] = [INSTRUMENT, 0, G5, 5, C6, 5, E6, 5, G6, 5, C7, 14, END];
/// Channel 0: the player's ship destroyed.
pub const DOWN: [u8; _] = [INSTRUMENT, 0, C5, 4, B4, 4, As4, 4, A4, 4, Gs4, 4, G4, 4, Fs4, 4, F4, 12, END];
/// Channel 0: a warning siren before the boss.
pub const SIREN: [u8; _] = [INSTRUMENT, 2, A5, 10, E5, 10, A5, 10, E5, 10, A5, 10, E5, 10, END];
/// Channel 0: stage clear.
pub const CLEAR: [u8; _] = [INSTRUMENT, 0, C5, 6, E5, 6, G5, 6, C6, 6, G5, 6, C6, 24, END];
/// Channel 0: start.
pub const START: [u8; _] = [INSTRUMENT, 1, A4, 4, E5, 4, A5, 4, E6, 10, END];
