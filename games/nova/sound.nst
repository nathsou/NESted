//! Nova's music and sound effects, as streams for std::audio.
use std::audio::*;

const S: u8 = 7;
const E: u8 = 14;
const Q: u8 = 28;

// ------------------------------------------------------------------ title

/// A slow, spacious arpeggio over a pad.
pub const TITLE_LEAD: [u8; _] = [
    INSTRUMENT, 2,
    E5, Q * 2, D5, Q, B4, Q,
    C5, Q * 2, B4, Q, G4, Q,
    A4, Q * 3, B4, Q,
    E4, Q * 4,
    LOOP,
];
pub const TITLE_ARP: [u8; _] = [
    INSTRUMENT, 7,
    A3, E, E4, E, A4, E, C5, E, A3, E, E4, E, A4, E, C5, E,
    F3, E, C4, E, F4, E, A4, E, F3, E, C4, E, F4, E, A4, E,
    D3, E, A3, E, D4, E, F4, E, D3, E, A3, E, D4, E, F4, E,
    E3, E, B3, E, E4, E, Gs4, E, E3, E, B3, E, E4, E, Gs4, E,
    LOOP,
];
pub const TITLE_BASS: [u8; _] = [
    INSTRUMENT, 3,
    A2, Q * 4, F2, Q * 4, D2, Q * 4, E2, Q * 4,
    LOOP,
];

