/// Fewest moves that clear each level.
pub const PAR: [u8; 25] = [3, 4, 6, 7, 9, 15, 8, 9, 11, 12, 16, 7, 11, 12, 14, 8, 10, 11, 13, 14, 12, 15, 19, 21, 24];

/// Level names, 16 characters each.
pub const NAMES: [u8; _] = "FIRST SLIDE     TURNING POINT   TIGHT SQUEEZE   CORNERS         DETOUR          LONG WAY ROUND  SOFT LANDING    SNOWDRIFT       PATCHWORK       FROST BITE      DRIFTS          THIN ICE        STEPPING STONES SINKHOLES       BLACK WATER     PUSH            BLOCKADE        BUILDER         BRIDGEWORK      HEAVY LIFTING   THAW            ICEBREAKER      WHITEOUT        AVALANCHE       SUMMIT          ";

/// Cell codes in `MAPS`.
pub const ICE: u8 = 0;
pub const SNOW: u8 = 1;
pub const ROCK: u8 = 2;
pub const HOLE: u8 = 3;
pub const EXIT: u8 = 4;
pub const STAR: u8 = 5;
pub const BLOCK: u8 = 6;
pub const START: u8 = 7;

fn code(c: u8) -> u8 {
    return match c {
        '#' => ROCK,
        ',' => SNOW,
        'O' => HOLE,
        'E' => EXIT,
        '*' => STAR,
        'B' => BLOCK,
        '@' => START,
        _ => ICE,
    };
}

fn parse() -> [u8; SIZE] {
    var out: [u8; SIZE] = [0; SIZE];
    var n: u16 = 0;
    for i in 0..len(TEXT) {
        let c = TEXT[i];
        if c != '\n' && c != ' ' && n < SIZE {
            out[n] = code(c);
            n += 1;
        }
    }
    return out;
}

const SIZE: u16 = 5200;

/// Every level's cells, decoded from `TEXT` at compile time.
pub const MAPS: [u8; SIZE] = parse();
