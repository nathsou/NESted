{
  "Cartridge": {
    "prefix": "cartridge",
    "body": [
      "cartridge {",
      "    title = \"${1:My Game}\";",
      "    mapper = ${2|nrom,cnrom,uxrom,axrom,bnrom,gxrom,colordreams,mmc1,mmc3|};",
      "    mirroring = ${3|vertical,horizontal|};",
      "    chr = \"${4:assets/tiles.chr}\";",
      "}",
      "",
      "use std::video;",
      "use std::input;",
      "",
      "fn init() {",
      "    $0",
      "}",
      "",
      "fn update() {",
      "}"
    ],
    "description": "A new cartridge with the standard runtime hooks"
  },
  "Game update": {
    "prefix": "update",
    "body": [
      "fn update() {",
      "    ${1:// Runs once per frame; drawing is published at the next vertical blank.}",
      "}"
    ],
    "description": "Per-frame hook called by std::runtime"
  },
  "Initialization": {
    "prefix": "init",
    "body": [
      "fn init() {",
      "    $0",
      "}"
    ],
    "description": "Runs once at power-on with rendering off"
  },
  "Vertical blank": {
    "prefix": "vblank",
    "body": [
      "fn vblank() {",
      "    $0",
      "}"
    ],
    "description": "Runs in every NMI, after the frame is published"
  },
  "Struct": {
    "prefix": "struct",
    "body": [
      "struct ${1:Name} {",
      "    ${2:x}: ${3:u8},",
      "}"
    ],
    "description": "A struct (stored field by field)"
  },
  "Enum": {
    "prefix": "enum",
    "body": [
      "enum ${1:Name} {",
      "    ${2:A},",
      "    ${3:B},",
      "}"
    ],
    "description": "An enum"
  },
  "Range type": {
    "prefix": "range",
    "body": [
      "type ${1:Slot} = u8 in 0..${2:8};"
    ],
    "description": "A u8 the compiler proves stays in range"
  },
  "Module import": {
    "prefix": "use",
    "body": [
      "use ${1|std::video,std::input,std::audio,std::math,std::mapper,std::nes,std::runtime|};"
    ],
    "description": "Import a module"
  },
  "For loop": {
    "prefix": "for",
    "body": [
      "for ${1:i} in ${2:0}..${3:8} {",
      "    $0",
      "}"
    ],
    "description": "Loop over a half-open range"
  },
  "Match": {
    "prefix": "match",
    "body": [
      "match ${1:value} {",
      "    ${2:0} => ${3:{}},",
      "    _ => ${4:{}},",
      "}"
    ],
    "description": "Exhaustive match"
  },
  "Inline assembly": {
    "prefix": "asm",
    "body": [
      "asm {",
      "    lda {${1:name}}",
      "    $0",
      "}"
    ],
    "description": "Inline 6502 assembly; {name} is a variable's address"
  },
  "Asset": {
    "prefix": "asset",
    "body": [
      "const ${1:DATA}: [u8; _] = asset(\"${2:assets/data.bin}\");"
    ],
    "description": "Bytes of a project file, in ROM"
  },
  "Banked constant": {
    "prefix": "bank",
    "body": [
      "@bank(${1:0}) const ${2:DATA}: [u8; _] = asset(\"${3:assets/data.bin}\");"
    ],
    "description": "Data in a switchable PRG bank; reads switch banks automatically"
  },
  "Cycle budget": {
    "prefix": "budget",
    "body": [
      "@budget(${1:200})",
      "fn ${2:name}() {",
      "    $0",
      "}"
    ],
    "description": "Prove a worst-case cycle bound for loop-free code"
  }
}